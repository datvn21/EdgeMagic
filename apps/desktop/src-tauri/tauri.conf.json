{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EdgeMagic",
  "version": "0.1.0",
  "identifier": "app.edgemagic.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist-web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "",
        "width": 380,
        "height": 820,
        "resizable": false,
        "decorations": false,
        "shadow": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "transparent": true,
        "dragDropEnabled": false
      }
    ],
    "security": { "csp": null }
  },
  "plugins": { "sql": { "preload": ["sqlite:edgemagic.db"] } },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
