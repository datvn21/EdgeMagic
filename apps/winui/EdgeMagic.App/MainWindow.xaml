<Window
    x:Class="EdgeMagic.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="EdgeMagic">
  <Grid x:Name="Root" Background="#141414" Loaded="OnRootLoaded" PointerEntered="OnPointerEntered" PointerExited="OnPointerExited">
    <Border Margin="8" Padding="16" CornerRadius="16" Background="#1c1c1c" BorderBrush="#333333" BorderThickness="1">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBlock Text="EdgeMagic" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Grid.Column="1" Margin="4,0" Content="← edge" Click="OnLeftEdge" />
          <Button Grid.Column="2" Margin="4,0,0,0" Content="right edge" Click="OnRightEdge" />
        </Grid>
        <ComboBox x:Name="DisplayChoices" Header="Monitor" DisplayMemberPath="Name" SelectionChanged="OnDisplayChanged" />
        <TextBlock Text="Move to the edge handle to reopen the shelf. Leaving the shelf collapses it." TextWrapping="Wrap" Foreground="#a1a1a1" />
        <TextBlock x:Name="HotkeyStatus" Foreground="#a1a1a1" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Collapse" Click="OnCollapse" />
          <Button x:Name="PinButton" Content="Pin" Click="OnPinClick" />
        </StackPanel>
        <Border Height="1" Background="#333333" />
        <TextBlock Text="Notes" FontSize="18" FontWeight="SemiBold" />
        <TextBox x:Name="NoteInput" PlaceholderText="Write a note" AcceptsReturn="True" MinHeight="64" />
        <Button Content="Add note" Click="OnAddNote" HorizontalAlignment="Left" />
        <ListView x:Name="NotesList" MaxHeight="210" SelectionMode="None">
          <ListView.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Content}" Foreground="#a1a1a1" TextWrapping="Wrap" MaxLines="3" />
                </StackPanel>
                <Button Grid.Column="1" Content="×" Tag="{Binding Id}" Click="OnDeleteNote" />
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
        <TextBlock Text="To do" FontSize="18" FontWeight="SemiBold" />
        <TextBox x:Name="TodoInput" PlaceholderText="Add a task" />
        <Button Content="Add task" Click="OnAddTodo" HorizontalAlignment="Left" />
        <ListView x:Name="TodosList" MaxHeight="180" SelectionMode="None">
          <ListView.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,2">
                <CheckBox IsChecked="{Binding Completed}" Tag="{Binding Id}" Click="OnToggleTodo" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Grid.Column="2" Content="×" Tag="{Binding Id}" Click="OnDeleteTodo" />
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
        <TextBlock x:Name="DataStatus" Foreground="#a1a1a1" TextWrapping="Wrap" />
      </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</Window>
