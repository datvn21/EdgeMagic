{
  "name": "@edgemagic/module-api",
  "version": "0.1.3",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./items": {
      "types": "./dist/items.d.ts",
      "default": "./dist/items.js"
    },
    "./sync": {
      "types": "./dist/sync.d.ts",
      "default": "./dist/sync.js"
    },
    "./platform": {
      "types": "./dist/platform/index.d.ts",
      "default": "./dist/platform/index.js"
    }
  },
  "dependencies": {
    "@edgemagic/types": "0.1.3"
  }
}
